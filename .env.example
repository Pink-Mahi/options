# ---- AI Options Income & Profit Calculator ----
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Server-side only.

# Database (PostgreSQL via Docker)
DATABASE_URL="postgresql://opc:opc_dev_password@localhost:5432/opc?schema=public"

# Market data provider: tradier (first integration). Provider abstraction allows more later.
MARKET_DATA_PROVIDER="tradier"
MARKET_DATA_API_KEY=""
# Tradier sandbox: https://sandbox.tradier.com/v1  |  production: https://api.tradier.com/v1
TRADIER_BASE_URL="https://sandbox.tradier.com/v1"
# Set to "delayed" or "realtime" depending on your Tradier subscription entitlement.
TRADIER_ENTITLEMENT="delayed"
# For production: set TRADIER_BASE_URL="https://api.tradier.com/v1" and TRADIER_ENTITLEMENT="realtime"

# Optional: News API for news & sentiment (newsapi.org or Alpha Vantage)
# NEWS_API_KEY=""
# ALPHA_VANTAGE_API_KEY=""

# AI provider (OpenAI-compatible). Phase 5 — preserved interface, not yet active.
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Auth (Phase 9)
# The first user created via /setup becomes the admin.
# Alternatively, set ADMIN_EMAIL + ADMIN_PASSWORD below to auto-seed the admin
# on every container startup. If the user already exists, the password is
# rotated to match the env var (so changing it + redeploying updates the password).
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="changeme123"
# ADMIN_NAME="Admin"

# Scheduled alert delivery (Phase 13)
# CRON_SECRET="" — protect /api/cron/* endpoints with a shared secret
# EMAIL_HOST="" — SMTP host for email notifications (optional)
# EMAIL_PORT="587" — SMTP port
# EMAIL_USER="" — SMTP username
# EMAIL_PASS="" — SMTP password
# EMAIL_FROM="" — from address for email notifications
# EMAIL_API_URL="" — alternative: HTTP-based email API (Resend, SendGrid)
# EMAIL_API_KEY="" — API key for HTTP-based email
# ALERT_WEBHOOK_URL="" — POST endpoint for webhook notifications (Slack, Discord, ntfy)
